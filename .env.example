# ---------------------------------------------------------------------------
# Supabase — Project Settings → API
# Puedes usar la "anon key" (legacy) o la "publishable key" (nueva).
# NUNCA pongas aquí la "service_role key": el panel del vendedor no la necesita.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-o-publishable-key

# ---------------------------------------------------------------------------
# URL pública del sitio (sin slash final). Se usa en SEO, sitemap y WhatsApp.
# En producción: https://tudominio.com
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
